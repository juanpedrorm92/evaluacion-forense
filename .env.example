# Destinatario de las solicitudes del formulario
CONTACT_TO=consultas@centroevaluacionesforense.cl

# Gmail SMTP
# 1) Activa verificación en 2 pasos en tu cuenta Google
# 2) Crea una "Contraseña de aplicaciones":
#    https://myaccount.google.com/apppasswords
# 3) Usa esa contraseña de 16 caracteres en SMTP_PASS (no tu clave normal)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=tu-correo@gmail.com

ALLOWED_ORIGIN=https://centroevaluacionesforense.cl,https://www.centroevaluacionesforense.cl
